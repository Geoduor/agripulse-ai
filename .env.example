# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (defaults to gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# WeatherAPI.com API Key (Get free key from https://www.weatherapi.com/)
WEATHER_API_KEY=your_weatherapi_key_here

# Frontend: base URL of the FastAPI backend (Vite reads this from the root .env)
VITE_API_URL=http://127.0.0.1:8000

# Optional: comma-separated frontend origins allowed by CORS (defaults to *)
CORS_ORIGINS=https://your-app.vercel.app

# Optional: Supabase PostgreSQL connection string (enables persistent DB storage)
# Get from: Supabase → Settings → Database → Session pooler URI (port 5432)
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
